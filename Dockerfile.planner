FROM python:3.13-slim
RUN pip install --no-cache-dir uv==0.6.13
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY src ./src
RUN useradd --uid 10001 --create-home max && mkdir /data && chown max:max /data
USER max
ENV MAX_MEMORY_DB=/data/max.sqlite3
EXPOSE 8080
CMD [".venv/bin/uvicorn", "max_agent.planner_service:create_app", "--factory", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8080"]

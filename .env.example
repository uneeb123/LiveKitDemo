# Both worker and planner service need LiveKit Inference credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# dual = full-duplex conversation + remote cascaded planner (default)
# cascade = original standalone STT/LLM/TTS mode
MAX_RUNTIME_MODE=dual
MAX_BACKEND_URL=http://127.0.0.1:8080
# Generate a random secret of at least 32 characters; use the same on worker/server.
MAX_BACKEND_TOKEN=
# This path belongs to the planner service in dual mode, and worker in cascade mode.
MAX_MEMORY_DB=./data/max.sqlite3
MAX_CONSOLE_USER_ID=local-demo
MAX_DUPLEX_VOICE=marin
MAX_DUPLEX_BACKEND_MODEL=gpt-5.6-luna
MAX_PLANNER_LLM=google/gemma-4-31b-it
MAX_LLM=google/gemma-4-31b-it
MAX_STT=assemblyai/assemblyai-stt-3-7-realtime-agent
MAX_TTS=fishaudio/s2.1-pro
MAX_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
# Worker only: exe.dev VM HTTPS token for a PRIVATE exe.dev endpoint.
# Sent separately in X-Exedev-Authorization; backend token stays in Authorization.
MAX_EXE_VM_TOKEN=
